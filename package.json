{
  "name": "bilabot-xiaozhi-web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "node --test tests/*.test.mjs",
    "build:pages": "node cloudflare/scripts/prepare.mjs && vite build --config cloudflare/vite.config.js",
    "preview:pages": "npm run build:pages && wrangler pages dev dist"
  },
  "dependencies": {
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "version": "1.0.0"
}
